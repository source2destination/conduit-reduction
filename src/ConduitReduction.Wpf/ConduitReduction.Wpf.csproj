<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ConduitReduction</AssemblyName>
    <RootNamespace>ConduitReduction.Wpf</RootNamespace>
    <ApplicationIcon>Assets\conduit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\conduit.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
